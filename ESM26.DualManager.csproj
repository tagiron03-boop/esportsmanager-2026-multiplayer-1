<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>ESM26.DualManager</AssemblyName>
    <RootNamespace>ESM26.DualManager</RootNamespace>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS8981;CS0108;CS0436</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Plugin.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
  </ItemGroup>

  <!--
    Подключаются все .dll из папки refs. Это интероп-сборки, которые BepInEx
    генерирует при первом запуске игры (папка BepInEx\interop).
    Нужны как минимум:
      Il2Cppmscorlib.dll
      UnityEngine.CoreModule.dll
      UnityEngine.IMGUIModule.dll
      UnityEngine.InputLegacyModule.dll
  -->
  <ItemGroup>
    <Reference Include="refs\*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
